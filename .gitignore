# Python
__pycache__/
*.pyc

# LaTeX build artifacts (regenerated by pdflatex/biber/latexmk)
report/*.aux
report/*.bbl
report/*.bbl-SAVE-ERROR
report/*.bcf
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.run.xml
report/*.synctex.gz

# OS junk
.DS_Store
Thumbs.db

# Office lock/temp files (created while a workbook is open, block git otherwise)
~$*.xlsx
~$*.xls
~$*.docx
